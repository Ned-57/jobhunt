# Copy to .env and edit. Every value here has a working default.

# local | supabase
JOBHUNT_STORAGE=local

# Where the local JSON files live
# JOBHUNT_DATA_DIR=D:\Projects\jobhunt\data

# Signs the session cookie. Generated and cached in data/.secret_key if unset.
# JOBHUNT_SECRET_KEY=

JOBHUNT_HOST=127.0.0.1
JOBHUNT_PORT=8121

# Only read when JOBHUNT_STORAGE=supabase. Server-side only - never ship the
# service key to the browser.
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_SERVICE_KEY=
